# Safe local defaults for Stage 3.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info
MENGHUAN_DATA_REPOSITORY=mock

# Required only when MENGHUAN_DATA_REPOSITORY=database.
# DATABASE_URL=postgresql://username:password@localhost:5432/menghuan

# Used only by the isolated database integration test command.
# TEST_DATABASE_URL=postgresql://username:password@localhost:5432/menghuan_test
MENGHUAN_SYNTHETIC_MODE=off
MENGHUAN_SYNTHETIC_DATABASE_URL=
MENGHUAN_REVIEW_MODE=off
MENGHUAN_REVIEW_DATABASE_URL=
# Stage5D synthetic-only preparation; default off, never a platform auth assertion.
MENGHUAN_PREVIEW_REVIEW_MODE=off
